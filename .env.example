# Copy to .env and fill in. Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://zelthia.vercel.app
# Optional: shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Database (accounts, sessions, health profiles). Tables are created on first use.
DATABASE_URL=postgresql://user:password@host:5432/zelthia
# Optional PEM root CA certificate (use \n for newlines) if your Postgres host uses a private CA.
DATABASE_CA_CERT=

# Comma-separated administrator email addresses allowed to review and approve facility licences at /admin.
ADMIN_EMAIL=admin@example.com

# AI providers, tried in this order. Unset keys are skipped.
AI_PROVIDER_ORDER=groq,gemini,nvidia,apmix,openai
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_FALLBACKS=3

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=2600

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2600

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
NVIDIA_MAX_OUTPUT_TOKENS=2600

APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=
APMIX_MAX_OUTPUT_TOKENS=2600

OPENAI_API_KEY=
OPENAI_MAX_OUTPUT_TOKENS=2600

# Web search and photos for "where can I get this" answers.
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=

# Private file storage for chat uploads and recorded directions.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# Speech to text for recorded directions.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT_MS=45000
